{{ 'authorized-locator.css' | asset_url | stylesheet_tag }}

<script>
  window.STORE_ID = {{ shop.id }};
</script>

<script>
  window.RETAILER_API_URL = "https://attraction-clock-cant-gabriel.trycloudflare.com";
</script>

<script src="{{ 'authorized-locator.js' | asset_url }}" defer></script>

<div class="authorized-locator-page">

  <section class="hero-banner-section {% if block.settings.banner-height == 'medium-height' %}inner-banner{% endif %}">
    
    <div class="inner-wrap">

      <div class="bg-img zoom-animation">

        {% if block.settings.desk_image != blank %}
          <img
            class="desk-img"
            src="{{ block.settings.desk_image | image_url: width: 2000 }}"
            alt="{{ block.settings.desk_image.alt | escape }}"
            width="2000"
            height="800"
          >
        {% endif %}

        {% if block.settings.mob_image != blank %}
          <img
            class="mob-img"
            src="{{ block.settings.mob_image | image_url: width: 800 }}"
            alt="{{ block.settings.mob_image.alt | escape }}"
            width="800"
            height="600"
          >
        {% endif %}

      </div>

      <div class="banner-content zoom-animation">
        <div class="content-inner">

          {% if block.settings.heading != blank %}
            <h1>{{ block.settings.heading }}</h1>
          {% else %}
            <h1>{{ page.title }}</h1>
          {% endif %}

          {% if block.settings.sub_heading != blank %}
            <p>{{ block.settings.sub_heading }}</p>
          {% endif %}

        </div>
      </div>

    </div>

  </section>
  <div class="content-sections">
    <section class="section-wrapper breadcrumb-section">
        <div class="container">
            <nav class="breadcrumbs-nav">
                <ul class="breadcrumbs-items mobile-hide">
                    <li class="breadcrumbs-item">
                        <a class="breadcrumbs-link" href="{{ routes.root_url }}" title="Home"><span>Home</span></a>
                    </li>
                    <li class="breadcrumbs-item">
                        <span class="active">{{ page.title }}</span>
                    </li>
                </ul>
                <a class="breadcrumbs-link mobile-show" href="{{ routes.root_url }}" title="Home">
                    <img src="//us.sennheiser-hearing.com/cdn/shop/files/back-button_5893f2d0-6563-4919-ab22-b7ce9e39eb43.svg?v=1759723589"
                        alt="">
                    <span>Home</span>
                </a>
            </nav>
        </div>
    </section>

    <section class="section-wrapper">
      <div class="container">
        <h2>{{ block.settings.page_content_title }}</h2>
        <div>{{ block.settings.page_center_content }}</div>
      </div>
    </section>

    <section class="section-wrapper dealer-locations-section">
      <div class="container">
          <div class="dealer-location-filters-block">
              <div class="search-container">
                  <div class="left-wrap">
                      <div class="input-box dropdown">
                         <input type="text" placeholder="Search City, Postal Code, Address" name="location-address" class="dropdown-btn">
                          <div class="dropdown-list">
                                <div>Consumer Headphones</div>
                                <div>Hearing Solutions</div>
                                <div>TV Listening</div>
                                <div>Soundbars</div>
                                <div>Accessories</div>
                            </div>
                            <button class="current-location-btn" title="Current Location" id="current-location-btn"></button>
                            <button class="reset-location-btn" title="Reset Location" id="reset-location-btn" style="display:none;">Reset</button>
                            <!-- loader here -->
                            <div class="location-loader" id="location-loader">
                                <span class="spinner"></span>
                                <span class="loader-text">Detecting location...</span>
                            </div>
                      </div>
                  </div>
                  <div class="right-wrap">
                      <div class="dropdowns-wrap">
                        <div class="dropdown category" id="categoryDropdown">
                            <div class="dropdown-btn"><span class="placeholder">Select Category</span></div>
                           <div class="dropdown-list">
                                <div>Loading...</div>
                            </div>
                        </div>
                        <div class="dropdown radius" id="radiusDropdown">
                            <div class="dropdown-btn"><span class="placeholder">Radius</span></div>
                            <div class="dropdown-list">
                                <div>05 km / miles</div>
                                <div>10 km / miles</div>
                                <div>15 km / miles</div>
                                <div>20 km / miles</div>
                                <div>25 km / miles</div>
                            </div>
                        </div>
                      </div>
                      <button class="btn btn-primary">Search</button>
                  </div>
              </div>
          </div>
          <div class="dealer-location-block">
              <div class="left-block">
                  <div class="upper-block">
                      <h3>Dealers near "Gurgaon"</h3>
                      <p>Showing 4 authorized locations within 25 km</p>
                  </div>
                  <div class="lower-block" id="retailers-list">
                      <div class="custom-location-card">
                          <div class="content-block">
                              <div class="title-block">
                                  <h4>Audio Vision</h4>
                                  <span>4km</span>
                              </div>
                              <ul class="icon-list">
                                  <li>
                                      <em>
                                          <img src="{{ 'location-icon.svg' | asset_url }}" alt="Location Icon">
                                      </em>
                                      <span>
                                          Sector 11, Old Railway Road, Gurgaon
                                      </span>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'phone-icon.svg' | asset_url }}" alt="Phone Icon">
                                      </em>
                                      <a href="tel:+91 9154682813">+91 9154682813</a>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'web-icon.svg' | asset_url }}" alt="Web Icon">
                                      </em>
                                      <a href="" title="www.audiovision.com">www.audiovision.com</a>
                                  </li>
                              </ul>
                          </div>
                          <div class="btn-wrap">
                              <a href="#" class="btn secondary-btn" title="Visit Website">Visit
                                  website</a>
                              <a href="#" class="btn btn-primary" title="Get Direction">Get
                                  Direction</a>
                          </div>
                      </div>
                      <div class="custom-location-card">
                          <div class="content-block">
                              <div class="title-block">
                                  <h4>HearClear Solutions</h4>
                                  <span>8km</span>
                              </div>
                              <ul class="icon-list">
                                  <li>
                                      <em>
                                          <img src="{{ 'location-icon.svg' | asset_url }}" alt="Location Icon">
                                      </em>
                                      <span>
                                          Sadar Bazar Rd, Sector 12, Gurgaon
                                      </span>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'phone-icon.svg' | asset_url }}" alt="Phone Icon">
                                      </em>
                                      <a href="tel:+91 9711987395">+91 9711987395</a>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'web-icon.svg' | asset_url }}" alt="Web Icon">
                                      </em>
                                      <a href=""
                                          title="www.hearclearsolutions.in">www.hearclearsolutions.in</a>
                                  </li>
                              </ul>
                          </div>
                          <div class="btn-wrap">
                              <a href="#" class="btn secondary-btn" title="Visit Website">Visit
                                  website</a>
                              <a href="#" class="btn btn-primary" title="Get Direction">Get
                                  Direction</a>
                          </div>
                      </div>
                      <div class="custom-location-card">
                          <div class="content-block">
                              <div class="title-block">
                                  <h4>Tech Universe</h4>
                                  <span>12km</span>
                              </div>
                              <ul class="icon-list">
                                  <li>
                                      <em>
                                          <img src="{{ 'location-icon.svg' | asset_url }}" alt="Location Icon">
                                      </em>
                                      <span>
                                          Sector 12, Jacob Pura Rd, Gurgaon
                                      </span>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'phone-icon.svg' | asset_url }}" alt="Phone Icon">
                                      </em>
                                      <a href="tel:+91 9845964875">+91 9845964875</a>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'web-icon.svg' | asset_url }}" alt="Web Icon">
                                      </em>
                                      <a href="" title="www.techuniverse.com">www.techuniverse.com</a>
                                  </li>
                              </ul>
                          </div>
                          <div class="btn-wrap">
                              <a href="#" class="btn secondary-btn" title="Visit Website">Visit
                                  website</a>
                              <a href="#" class="btn btn-primary" title="Get Direction">Get
                                  Direction</a>
                          </div>
                      </div>
                      <div class="custom-location-card">
                          <div class="content-block">
                              <div class="title-block">
                                  <h4>Electronics Mart</h4>
                                  <span>14km</span>
                              </div>
                              <ul class="icon-list">
                                  <li>
                                      <em>
                                          <img src="{{ 'location-icon.svg' | asset_url }}" alt="Location Icon">
                                      </em>
                                      <span>
                                          Sector 12, Jacob Pura Rd, Gurgaon
                                      </span>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'phone-icon.svg' | asset_url }}" alt="Phone Icon">
                                      </em>
                                      <a href="tel:+91 9845964875">+91 9845964875</a>
                                  </li>
                                  <li>
                                      <em>
                                          <img src="{{ 'web-icon.svg' | asset_url }}" alt="Web Icon">
                                      </em>
                                      <a href="" title="www.techuniverse.com">www.techuniverse.com</a>
                                  </li>
                              </ul>
                          </div>
                          <div class="btn-wrap">
                              <a href="#" class="btn secondary-btn" title="Visit Website">Visit
                                  website</a>
                              <a href="#" class="btn btn-primary" title="Get Direction">Get
                                  Direction</a>
                          </div>
                      </div>
                  </div>
              </div>
              <div class="right-block">
                  <div class="map" id="map-container"
                  </div>
              </div>
          </div>
      </div>
    </section>
  </div>
</div>



{% schema %}
{
  "name": "Authorized locator page",
  "target": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desk_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mob_image",
      "label": "Mobile Image"
    },
    {
      "type": "select",
      "id": "banner-height",
      "label": "Image Banner height",
      "default": "full-height",
      "options": [
        { "label": "Full Height", "value": "full-height" },
        { "label": "Medium Height", "value": "medium-height" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Authorized Dealer Locator"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading Text",
      "default": "Hear the Difference"
    },
     {
      "type": "text",
      "id": "page_content_title",
      "label": "Content Title"
    },
    {
      "type": "richtext",
      "id": "page_center_content",
      "label": "Content"
    }
  ]
}
{% endschema %}